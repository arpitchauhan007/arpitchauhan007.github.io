 <body data-template-id="__page-root" class="w-full" style="background: rgb(248, 249, 250);"><!-- Hero -->
  <header class="relative overflow-hidden" style="min-height: calc(100 * min(var(--vh, 1vh), 1vh));"><img data-template-id="hero-bg" class="canva-image absolute inset-0 w-full h-full object-cover" loading="lazy" src="https://images.pexels.com/photos/12537427/pexels-photo-12537427.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1920" alt="High-tech abstract art featuring blue and teal circuit-like patterns with a digital vibe">
   <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/80"></div>
   <div class="relative z-10 flex flex-col items-center justify-center text-center px-6" style="min-height: calc(100 * min(var(--vh, 1vh), 1vh));"><img data-template-id="profile-photo" class="canva-image w-36 h-36 rounded-full object-cover border-4 border-white/30 shadow-2xl mb-8" loading="lazy" src="https://images.pexels.com/photos/33261949/pexels-photo-33261949.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800" alt="Professional portrait photo">
    <h1 data-template-id="hero-name" class="canva-text font-heading" style="color: rgb(255, 255, 255); font-weight: 900; font-style: normal; font-size: 56px;">Arpit Chauhan</h1>
    <p data-template-id="hero-subtitle" class="canva-text mt-3" style="color: rgb(167, 216, 208); font-weight: 500; font-style: normal; font-size: 20px;">Healthcare &amp; Biomedical Engineer</p>
    <p data-template-id="hero-contact" class="canva-text mt-4 opacity-80" style="color: rgb(255, 255, 255); font-weight: 400; font-style: normal; font-size: 14px;">+91 72172 41345 • arpitadeshchauhan@gmail.com • Bengaluru, India</p>
   </div>
  </header><!-- About -->
  <section class="py-20 px-6">
   <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
    <div>
     <h2 data-template-id="summary-title" class="canva-text font-heading mb-6" style="color: rgb(13, 59, 59); font-weight: 700; font-style: normal; font-size: 24px;">About Me</h2>
     <p data-template-id="summary-text" class="canva-text leading-relaxed" style="color: rgb(51, 51, 51); font-weight: 400; font-style: normal; font-size: 16px;">Biomedical Engineering graduate (Data Science specialization) with hands-on experience building healthcare AI, computer vision, and biomedical signal processing systems. Proficient in Python, SQL, TensorFlow, LSTM/CNN architectures, REST APIs, and Git. Built and deployed ML models for prosthetic control, medical imaging, and automation, with startup experience spanning product development, cross-functional coordination, and clinical validation.</p>
    </div><img data-template-id="about-image" class="canva-image w-full h-80 object-cover rounded-2xl shadow-xl" loading="lazy" src="https://images.pexels.com/photos/8442033/pexels-photo-8442033.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800" alt="A well-equipped laboratory with a microscope and vials ready for analysis">
   </div>
  </section><!-- Skills -->
  <section data-template-id="skills-section" class="canva-section py-20 px-6" style="background: rgb(13, 59, 59);">
   <div class="max-w-5xl mx-auto">
    <h2 data-template-id="skills-title" class="canva-text font-heading text-center mb-10" style="color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 24px;">Technical Skills</h2>
    <div class="space-y-6">
     <div>
      <h3 data-template-id="skills-lang-label" class="canva-text font-bold mb-2" style="color: rgb(94, 234, 212); font-weight: 700; font-style: normal; font-size: 14px;">Languages &amp; Databases</h3>
      <p data-template-id="skills-lang" class="canva-text" style="color: rgb(226, 232, 240); font-weight: 400; font-style: normal; font-size: 15px;">Python, SQL</p>
     </div>
     <div>
      <h3 data-template-id="skills-ml-label" class="canva-text font-bold mb-2" style="color: rgb(94, 234, 212); font-weight: 700; font-style: normal; font-size: 14px;">Machine Learning / AI</h3>
      <p data-template-id="skills-ml" class="canva-text" style="color: rgb(226, 232, 240); font-weight: 400; font-style: normal; font-size: 15px;">Deep Learning, Computer Vision, LSTM, CNN, Transfer Learning, TensorFlow, Keras, PyTorch, Hugging Face, OpenCV, Scikit-learn</p>
     </div>
     <div>
      <h3 data-template-id="skills-data-label" class="canva-text font-bold mb-2" style="color: rgb(94, 234, 212); font-weight: 700; font-style: normal; font-size: 14px;">Data &amp; Visualization</h3>
      <p data-template-id="skills-data" class="canva-text" style="color: rgb(226, 232, 240); font-weight: 400; font-style: normal; font-size: 15px;">Pandas, NumPy, Matplotlib, Power BI, Tableau</p>
     </div>
     <div>
      <h3 data-template-id="skills-tools-label" class="canva-text font-bold mb-2" style="color: rgb(94, 234, 212); font-weight: 700; font-style: normal; font-size: 14px;">Tools &amp; Platforms</h3>
      <p data-template-id="skills-tools" class="canva-text" style="color: rgb(226, 232, 240); font-weight: 400; font-style: normal; font-size: 15px;">Git, REST APIs, Jupyter Notebook, VS Code, Fusion 360, Blender, TinkerCAD</p>
     </div>
    </div>
   </div>
  </section><!-- Experience -->
  <section class="py-20 px-6">
   <div class="max-w-5xl mx-auto">
    <h2 data-template-id="exp-title" class="canva-text font-heading text-center mb-12" style="color: rgb(13, 59, 59); font-weight: 700; font-style: normal; font-size: 24px;">Experience</h2>
    <div class="space-y-8">
     <div data-template-id="exp1-card" class="canva-card p-8 rounded-2xl hover-lift" style="background: rgb(255, 255, 255);">
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
       <div>
        <h3 data-template-id="exp1-role" class="canva-text font-bold" style="color: rgb(17, 17, 17); font-weight: 700; font-style: normal; font-size: 18px;">GM Administration (Part-Time)</h3>
        <p data-template-id="exp1-company" class="canva-text mt-1" style="color: rgb(13, 115, 119); font-weight: 400; font-style: normal; font-size: 14px;">Rapha MedTech, Hyderabad • Oct 2024 – Present</p>
       </div>
      </div>
      <p data-template-id="exp1-desc" class="canva-text mt-4 leading-relaxed" style="color: rgb(68, 68, 68); font-weight: 400; font-style: normal; font-size: 15px;">Coordinated AI-based healthcare product development across multidisciplinary teams. Assisted in documentation, workflows, prototype planning, and clinical validation. Collaborated on rehabilitation technologies integrating ML and biomedical sensors.</p>
     </div>
     <div data-template-id="exp2-card" class="canva-card p-8 rounded-2xl hover-lift" style="background: rgb(255, 255, 255);">
